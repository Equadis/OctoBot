# Copy to .env and fill in. Never commit .env.
#
# Use a DEDICATED throwaway Turtle account, never your main. A parked, always-online
# character is detectable, and Turtle's rules forbid automation — this account is the
# one you are willing to lose.

# --- Game account (a vanilla 1.12 server; defaults target OctoWoW) ---
WOW_ACCOUNT=YOURACCOUNT
WOW_PASSWORD=yourpassword

# Auth (logon) server = the "set realmlist" value from your client's realmlist.wtf.
# Port is almost always 3724. OctoWoW moved this to play.octowow.st (2026-08); the
# old octowow.st is being retired.
WOW_AUTH_HOST=play.octowow.st
WOW_AUTH_PORT=3724

# The realm to enter, exactly as it appears in the realm list (case-insensitive).
# OctoWoW has several — this must match the one your character is on.
WOW_REALM=N'Zoth

# The character on the account to log in (must already exist). It just parks in a city.
WOW_CHARACTER=YourBotChar

# Client-integrity checksum (StrictVersionCheck). OctoWoW rejects logins whose
# integrity proof is wrong. The default is the verified 1.12.1 value and works
# out of the box for OctoWoW. Set to "none" for servers without StrictVersionCheck,
# or a 40-hex-char value for a different client build.
# WOW_INTEGRITY_CHECKSUM=

# Client build advertised at logon. Defaults to OctoWoW's custom build 7272 (stock
# 1.12.1 is 5875). If OctoWoW ships a client patch that bumps the build, the bot
# auto-heals it (see WOW_AUTO_RESOLVE); set this only to pin a specific build.
# WOW_BUILD=

# Auto-heal across OctoWoW client patches. When a login is rejected for a wrong
# build, the bot reads the current build from the CDN copy of WoW.exe using a tiny
# 4-byte HTTP Range request (not the whole client) and retries. On by default; set
# to false/0/none to pin WOW_BUILD and never touch the network for it.
# WOW_AUTO_RESOLVE=true

# CDN base the auto-heal reads WoW.exe from. Defaults to OctoWoW's public client CDN.
# WOW_CLIENT_CDN=https://dl.octowow.st/client/latest

# Client build in the world auth session. OctoWoW's client sends stock 5875 here
# (not the logon build). Only change if a patch alters it.
# WOW_WORLD_BUILD=

# Optional: override the world server address if the realm-list address is unreachable
# (some servers advertise an internal address). Leave blank to use the realm list.
# WOW_WORLD_HOST=
# WOW_WORLD_PORT=

# --- What to watch ---
# Onyxia's Lair area id in 1.12 is 2159. Change to watch a different instance.
WATCH_AREA_ID=2159
WATCH_AREA_NAME=Onyxia's Lair

# How often to run /who, in seconds. Keep this gentle (>=15) to respect the server.
POLL_INTERVAL_SECONDS=20

# How many players a group must reach for a raid to count as "about to start".
# Default 15 (an OctoWoW Onyxia raid is ~20-25). One alert fires when a group crosses
# this going up, and one when it drops below WOW_RAID_CLEAR_SIZE going down.
# WOW_MIN_RAID_SIZE=15

# The "raid left" floor. A raid re-arms (fires "left" and can alert again for the
# next raid) when it drops BELOW this — not only at exactly zero, since a busy lair
# rarely fully empties between raids. Must be < WOW_MIN_RAID_SIZE. Default: a third
# of it (5 for the default 15).
# WOW_RAID_CLEAR_SIZE=5

# How to tell several simultaneous raids apart. /who gives no instance id — just a
# flat list of everyone in the zone (capped at 49 names) — so the only field that
# separates concurrent raids is the guild tag.
#   auto  = (default) a guild that reaches the threshold is its own named raid;
#           everyone else — scattered guilds and the unguilded — pools into one
#           "pickup" cohort that forms its own raid. Catches guild raids AND pickups,
#           and a guild raid running next to a pickup one shows as two.
#   guild = every guild is its own raid; misses a pickup raid spread across guilds.
#   lair  = the whole lair is one raid (simplest; can't separate two at once).
# Note: two concurrent PICKUP raids still read as one — no /who field can split them.
# WOW_RAID_GROUPING=auto

# Which detector drives alerts:
#   count    = (default) head-count with hysteresis (WOW_MIN_RAID_SIZE / _CLEAR_SIZE).
#   temporal = groups players by arrival time; catches a raid leaving together even
#              when the lair stays busy. Runs in shadow (logs what it WOULD fire)
#              whenever it isn't the live detector, so it can be validated first.
# WOW_RAID_DETECTOR=count

# How many minutes before a raid's predicted clear the "might end soon" alert goes out.
# Default 20: at 10, a quarter of raids had already cleared before it fired.
# WOW_RAID_ENDING_LEAD_MINUTES=20

# --- Blackwing Lair ---
# Nefarian's head drops the same Rallying Cry as Onyxia's, so BWL is watched as a
# second lair: its own /who poll, raid numbers, alert dedup, learned clear time
# and snapshots. Its alerts and its head's drops post to DISCORD_BWL_CHANNEL_ID.
# The buff cooldown is shared, since it is one buff whichever head dropped it.
# On by default; false/0/none turns BWL off entirely.
# WOW_BWL_ENABLED=true
# WOW_BWL_AREA_ID=2677
# WOW_BWL_AREA_NAME=Blackwing Lair
# Slower than Onyxia's poll: a BWL raid lasts hours, and every /who spends the
# same per-IP budget (both lairs' polls share one queue).
# WOW_BWL_POLL_INTERVAL_SECONDS=60
# A BWL raid is 40-man; these mirror the WOW_RAID_* knobs above, scaled up.
# WOW_BWL_MIN_RAID_SIZE=20
# WOW_BWL_RAID_CLEAR_SIZE=6
# WOW_BWL_RAID_STRENGTH_SIZE=20
# WOW_BWL_RAID_LEFT_FLOOR=20
# WOW_BWL_RAID_ROSTER_CAP=45
# Clear time guessed until WOW_BWL_RAID_LEARN_MIN_SAMPLES clears are on record.
# WOW_BWL_RAID_DURATION_MINUTES=150
# WOW_BWL_RAID_LEARN_MIN_SAMPLES=10
# WOW_BWL_RAID_ENDING_LEAD_MINUTES=20
# WOW_BWL_RAID_FILL_WINDOW_MINUTES=15
# A raid that leaves sooner than this is a disband, not a clear.
# WOW_BWL_RAID_DISBAND_MINUTES=60
# WOW_BWL_RAID_MIN_CLEAR_MINUTES=30
# WOW_BWL_RAID_MAX_CLEAR_HOURS=10
# WOW_BWL_RAID_CLEAR_SUSTAINED_MINUTES=5
# WOW_BWL_RAID_LOCKOUT_HOURS=4
# WOW_BWL_RAID_FORM_CONFIRM_MINUTES=0
# A Nefarian-head drop this soon after the lair emptied reads as a fresh kill.
# WOW_BWL_DROP_FRESH_WINDOW_MINUTES=40

# --- Alerts ---
# Discord channel webhook URL (Server Settings > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Optional: opt-in notifications. Create a self-assignable role (e.g. @OnyxiaWatch)
# and put its numeric id here. Raid enter/leave posts will ping ONLY that role, so
# only members who took the role get notified. Leave blank to just post silently to
# the channel. To get the id: Discord Developer Mode on, right-click the role >
# Copy Role ID.
DISCORD_MENTION_ROLE_ID=

# Post a "bot online" message to Discord on startup. Off by default to stay quiet —
# the bot restarts (redeploys, reconnects) shouldn't each announce themselves. Set
# to true/1 if you want a heartbeat on boot.
# WOW_ANNOUNCE_STARTUP=false

# --- In-game whisper interface ---
# The bot's character answers whispers and can whisper subscribers when a raid
# forms or clears. Commands (whisper the bot): subscribe, unsubscribe, status, me,
# help. To also get raid alerts as Discord DMs, a player links their Discord:
#   "discord"       -> bot replies with a code; join the server and DM the code to
#                      the bot (flow A, needs the gateway below).
#   "discord <id>"  -> bot DMs that user a code; whisper it back in-game (flow B).
#   "mode both"     -> in-game whisper AND a Discord DM every time.
#   "mode offline"  -> a Discord DM only when your character is offline in-game.
# NOTE: this makes the character actively talk in-game — far more visible, and more
# reportable, than the silent /who poller. Set to false/0/none to disable it entirely
# (the bot then only posts to the webhook channel and ignores whispers).
# WOW_WHISPERS=true

# Delay between outgoing whispers (ms). The server mutes bursts of chat, so a raid
# alert to many subscribers is paced. Default 1200 (~1 whisper/sec).
# WOW_WHISPER_THROTTLE_MS=1200

# The capital status board — the raid in progress, the Darkmoon Faire, "whisper subscribe" —
# yelled city-wide every this many minutes. Off by default (0): the same words every few
# minutes wore on players. The one-off raid event yells (forming, ending soon, cleared,
# disbanded) are not affected.
# WOW_STATUS_YELL_MINUTES=0

# Whether a player can get a guild invite from the bot: the "ginvite" command, its
# line in "help", and the offer to a guild question. Off by default; true/1 turns it
# on. The bot never invites anyone who didn't ask.
# WOW_GUILD_INVITE=false

# --- Discord DMs (optional) ---
# A Discord BOT TOKEN turns on personal DM alerts and Discord-side linking. Create a
# bot at https://discord.com/developers, invite it to the SAME server your webhook
# posts to (subscribers must share a server with the bot to be DM'd), and paste its
# token here. Without it, the discord commands say "isn't set up" and only in-game
# whispers + the webhook channel post work.
# DISCORD_BOT_TOKEN=

# Your server's invite link, shown in link instructions so users can join.
# DISCORD_SERVER_INVITE_URL=https://discord.gg/xxxxxxx

# Run the Discord gateway for link flow A (DM the bot a code). Requires enabling the
# MESSAGE CONTENT privileged intent on the bot (free under 100 servers). Set to
# false/0/none to disable flow A; flow B ("discord <id>") still works without it.
# DISCORD_GATEWAY=true

# --- Live server-status widget (optional) ---
# Channel id where the bot keeps ONE message showing the realm's status (online/down +
# health), edited in place rather than reposted. Needs DISCORD_BOT_TOKEN. Unset = off.
# This is separate from the community down/up alerts (DISCORD_ONYXIA_CHANNEL_ID); it's the
# always-there dashboard, not the notification. Right-click the channel (Developer Mode on)
# > Copy Channel ID.
# DISCORD_SERVER_STATUS_CHANNEL_ID=1547634262730088508
# How often the widget re-renders to keep uptime/latency fresh (seconds, min 30, default 300).
# Realm up/down transitions refresh it immediately regardless.
# WOW_STATUS_REFRESH_SECONDS=300
# On a realm up/down change the bot posts a short notice to THIS channel (to fire the unread/push),
# then deletes it so only the pinned status embed remains. This is how long it lingers before deletion
# (seconds, default 5). A few seconds makes the notification register reliably across clients; 0 is
# immediate. (The old behaviour — posting up/down to the Onyxia buff channel — is gone.) WOW_REALM_STATUS
# still gates whether the notice fires at all.
# WOW_STATUS_NOTICE_LINGER_SECONDS=5
# Also reflect up/down in the channel NAME (🟢server-status / 🔴server-status), for an at-a-glance
# sidebar indicator on top of the embed. Needs the bot to have Manage Channels in that channel. Off
# by default; only renames on a confirmed up/down transition (stays under Discord's ~2/10min limit).
# WOW_STATUS_CHANNEL_RENAME=true
# Base name the channel is renamed around (the status emoji is prefixed). Default "server-status".
# WOW_STATUS_CHANNEL_NAME=server-status

# --- Darkmoon Faire ---
# Channel holding the live Darkmoon Faire board: ONE message the bot edits in place
# forever, never a stream of posts. Needs DISCORD_BOT_TOKEN, and the bot needs Send
# Messages there for the first post. Unset = no board (the "darkmoon" whisper command
# still works). The message id is remembered in MongoDB, so a redeploy keeps editing
# the same message instead of orphaning it and posting a second one.
#
# It shares WOW_STATUS_REFRESH_SECONDS as its tick, but only actually edits when the
# TEXT changes — the faire moves four times a month, so the channel sits still for weeks.
# DISCORD_DARKMOON_CHANNEL_ID=1550052958698479677

# --- Wall of shame ---
# Channel holding ONE pinned message listing every player who has killed a bot
# listener, a "- Name" line each: the killer, or the player whose pet, summon or
# charmed unit landed the killing blow. Needs DISCORD_BOT_TOKEN, and the bot needs
# Send Messages and Pin Messages there. The list and the message id are kept in
# MongoDB, so a redeploy edits the same message. Nothing is posted until the first
# kill. Unset = no wall.
# DISCORD_WALL_OF_SHAME_CHANNEL_ID=1552341406356611206

# --- Blackwing Lair channel ---
# BWL's raid alerts and Nefarian-head Rallying Cry drops post here. Unset = the
# Onyxia channel, alongside Onyxia's.
# DISCORD_BWL_CHANNEL_ID=

# --- Listener safety ---
# A parked listener logs out when an Inferno is cast to land within this many
# yards, or an Infernal is in or heading into that range — near enough to be meant
# for it, far enough to leave before it is in reach (a logout in a capital is
# instant). The caster, or the Infernal's owner, is named by the other characters and
# put on the wall of shame. The listener logs back in after the stand-down, and
# leaves again if the threat is still there. Defaults: 40 yards, 5 minutes.
# WOW_LISTENER_THREAT_RADIUS_YARDS=40
# WOW_LISTENER_STAND_DOWN_MINUTES=5
# Also leave when a player on the wall of shame merely stands within the radius.
# Off by default: their Inferno is caught as it is cast, so the listener stays up
# beside them (a banned player parked there would otherwise keep a city dark).
# WOW_LISTENER_FLEE_SHUNNED_PLAYERS=false

# --- Darkmoon Faire: where it is (the "darkmoon" whisper command) ---
# There is NO schedule here, on purpose. The bot only ever reports where the faire was
# last SEEN, and how long ago. Turtle does not run the vanilla calendar — it alternates
# weekly and is up almost every day — and any rule hardcoded here would be one server
# patch away from being confidently wrong for a month before anyone noticed.
#
# Two sources feed it, both things the bot already receives:
#   - our own character, if parked at a faire site (see below)
#   - PizzaWorldBuffs sightings on the hidden "LFT" channel
# Whichever look is NEWER wins, because the faire really does move. Both are persisted
# in MongoDB, so a redeploy does not forget.

# Where the watcher's character is parked, IF it is parked at a faire site. Set it and
# the bot asks the server what the NPCs beside it are called and recognises the faire's
# own staff — first-hand, unforgeable, and the only source that covers the moment the
# faire ARRIVES. Unset (the default) = not at a faire site, detection off.
#
# This is configuration, not detection: an object update says what is NEARBY, never
# which zone we are in. Set it wrong and the bot will confidently report the wrong zone,
# so change it whenever you move the character, and unset it when it is elsewhere.
# DARKMOON_WATCH_LOCATION=elwynn

# Tamper resistance for the LFT feed, which is player-typed text anyone can forge.
# A sighting is a VOTE, counted per distinct SENDER (the server stamps who sent a
# channel line; the "witness" inside the message does not count, since it is part of
# what a troll would be typing). Honest traffic is many senders repeating one witness,
# so this is cheap for the realm and expensive for a liar.
# How many distinct senders must agree before a sighting is believed. 1 restores
# PizzaWorldBuffs' own trust-whoever-spoke-last behaviour. Default 3.
# DARKMOON_QUORUM=3
# Once a zone is settled, how long before it may move to the other zone. The faire's
# real move comes a week apart, so this only stops flapping. Default 12, max 24.
# DARKMOON_CHANGE_COOLDOWN_HOURS=12

# --- Subscriber store (MongoDB) ---
# Where subscribers are persisted. Without MONGODB_URI they live in memory and are
# lost on restart/redeploy. On Railway, add a MongoDB service and use its connection
# string (a Railway volume backs it, so subscriptions survive deploys).
# MONGODB_URI=mongodb://user:pass@host:27017
# MONGODB_DB=onyxiabot

# Optional log level: debug | info | warn | error
LOG_LEVEL=info
